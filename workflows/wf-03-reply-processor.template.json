{
  "name": "WF-03 Reply Processor",
  "active": false,
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "name": "Called by Command Center",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [160, 160]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "limit": 25,
        "simple": false,
        "filters": {
          "includeSpamTrash": false,
          "q": "newer_than:14d -from:YOUR_REPLY_TO_EMAIL",
          "readStatus": "unread"
        },
        "options": { "downloadAttachments": false }
      },
      "name": "Fetch Recent Unread Replies",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [460, 160]
    },
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyX", "value": 15, "unit": "minutes" }] },
        "simple": false,
        "filters": {
          "includeSpamTrash": false,
          "includeDrafts": false,
          "q": "newer_than:14d -from:YOUR_REPLY_TO_EMAIL",
          "readStatus": "unread"
        },
        "options": { "downloadAttachments": false }
      },
      "name": "Gmail Reply Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [160, 460]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const json = item.json;\n  const fromValue = json.from?.value?.[0] || {};\n  const emailMatch = String(json.from?.text || json.headers?.from || '').match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n  const senderEmail = fromValue.address || (emailMatch ? emailMatch[0] : '');\n  const body = json.text || json.textPlain || json.textAsHtml || json.html || json.snippet || '';\n  return { json: { SenderEmail: senderEmail, SenderName: fromValue.name || '', Subject: json.subject || json.headers?.subject || '', Body: body, GmailMessageId: json.id || '', GmailThreadId: json.threadId || '', ReceivedDate: json.date || json.headers?.date || '' } };\n}).filter((item) => item.json.SenderEmail && item.json.Body);"
      },
      "name": "Normalize Incoming Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this buyer email reply and classify it as Inquiry, Negotiation, Purchase Order, or Rejected. Subject: {{ $json.Subject }}. Body: {{ $json.Body }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Inquiry includes catalog, sample, price, quotation, MOQ, specification. Negotiation includes payment, terms, shipment, delivery, incoterm. Purchase Order includes PO, Purchase Order, Order Confirmation. Rejected includes Not Interested, Remove Us, No Demand. Return structured JSON only.",
          "maxIterations": 3
        }
      },
      "name": "Classify Buyer Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "gpt-5-mini" },
        "options": { "reasoningEffort": "high" }
      },
      "name": "OpenAI Reply Classifier Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [1040, 540]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"status\":\"Inquiry\",\"summary\":\"Buyer asked for pricing and MOQ.\",\"confidence\":0.94}"
      },
      "name": "Reply Status JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [1260, 540]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_BUYER_DATABASE_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "YOUR_BUYER_DATABASE_SHEET_NAME" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Email"],
          "value": {
            "Email": "={{ $(\"Normalize Incoming Reply\").item.json.SenderEmail }}",
            "Status": "={{ $json.status }}",
            "Last Contact Date": "={{ $now.toFormat(\"yyyy-MM-dd\") }}",
            "Reply Summary": "={{ $json.summary }}",
            "Reply Confidence": "={{ $json.confidence }}"
          }
        },
        "options": { "cellFormat": "USER_ENTERED" }
      },
      "name": "Update Buyer Status from Reply",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1320, 300]
    }
  ],
  "connections": {
    "Called by Command Center": { "main": [[{ "node": "Fetch Recent Unread Replies", "type": "main", "index": 0 }]] },
    "Fetch Recent Unread Replies": { "main": [[{ "node": "Normalize Incoming Reply", "type": "main", "index": 0 }]] },
    "Gmail Reply Trigger": { "main": [[{ "node": "Normalize Incoming Reply", "type": "main", "index": 0 }]] },
    "Normalize Incoming Reply": { "main": [[{ "node": "Classify Buyer Reply", "type": "main", "index": 0 }]] },
    "OpenAI Reply Classifier Model": { "ai_languageModel": [[{ "node": "Classify Buyer Reply", "type": "ai_languageModel", "index": 0 }]] },
    "Reply Status JSON Parser": { "ai_outputParser": [[{ "node": "Classify Buyer Reply", "type": "ai_outputParser", "index": 0 }]] },
    "Classify Buyer Reply": { "main": [[{ "node": "Update Buyer Status from Reply", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
