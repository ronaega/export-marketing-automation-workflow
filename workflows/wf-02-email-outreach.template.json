{
  "name": "WF-02 Email Outreach",
  "active": false,
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "name": "Called by Command Center",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_BUYER_DATABASE_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "YOUR_BUYER_DATABASE_SHEET_NAME" },
        "filtersUI": { "values": [{ "lookupColumn": "Status", "lookupValue": "No Action" }] },
        "options": {}
      },
      "name": "Read No Action Buyers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const command = $('Called by Command Center').first().json;\nconst requestedCountry = String(command.country || '').trim().toLowerCase();\nreturn $input.all()\n  .filter((item) => item.json.Email && (!requestedCountry || String(item.json.Country || '').toLowerCase() === requestedCountry))\n  .map((item) => ({ json: item.json }));"
      },
      "name": "Filter Outreach Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a warm personalized opening sentence for {{ $json[\"Company Name\"] }}. Website: {{ $json.Website }}. Country: {{ $json.Country }}. Maximum 2 sentences. Do not invent specific claims unless supported by the website.",
        "options": {
          "systemMessage": "You write concise B2B export outreach personalization for Indonesian commodity suppliers.",
          "maxIterations": 4
        }
      },
      "name": "Create Personalized Opening",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "gpt-5-mini" },
        "responsesApiEnabled": true,
        "builtInTools": { "webSearch": { "searchContextSize": "low" } },
        "options": { "reasoningEffort": "high" }
      },
      "name": "OpenAI Personalization Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [1020, 540]
    },
    {
      "parameters": {
        "jsCode": "const leads = $('Filter Outreach Targets').all().map((item) => item.json);\nconst personalizations = $input.all();\nreturn personalizations.map((item, index) => {\n  const lead = leads[index] || {};\n  const opening = item.json.output || 'We noticed your company activities and believe there may be opportunities for cooperation.';\n  const company = lead['Company Name'] || 'your company';\n  const message = `Dear Sir/Madam,<br><br>I hope this message finds you well.<br><br>My name is YOUR_SENDER_NAME, and I represent YOUR_COMPANY_NAME.<br><br>We specialize in high-quality Indonesian commodities.<br><br>${opening}<br><br>We are currently expanding our international network and would be pleased to explore potential cooperation opportunities with ${company}.<br><br>Please find our company profile and product catalog attached for your reference.<br><br>Best Regards,<br>YOUR_SENDER_NAME<br>YOUR_COMPANY_NAME<br>Email: YOUR_REPLY_TO_EMAIL`;\n  return { json: { ...lead, PersonalizedOpening: opening, Subject: 'Indonesian Commodity Supplier Introduction - YOUR_COMPANY_NAME', Message: message } };\n});"
      },
      "name": "Prepare Email Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "YOUR_COMPANY_PROFILE_FILE_ID" },
        "options": { "binaryPropertyName": "companyProfile" }
      },
      "name": "Download Company Profile PDF",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1580, 300]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "YOUR_CATALOG_PRODUCT_FILE_ID" },
        "options": { "binaryPropertyName": "catalogProduct" }
      },
      "name": "Download Catalog Product PDF",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1860, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $(\"Prepare Email Body\").item.json.Email }}",
        "subject": "={{ $(\"Prepare Email Body\").item.json.Subject }}",
        "emailType": "html",
        "message": "={{ $(\"Prepare Email Body\").item.json.Message }}",
        "senderName": "YOUR_SENDER_NAME",
        "replyTo": "YOUR_REPLY_TO_EMAIL",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              { "property": "companyProfile" },
              { "property": "catalogProduct" }
            ]
          }
        }
      },
      "name": "Send Company Profile Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [2140, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_BUYER_DATABASE_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "YOUR_BUYER_DATABASE_SHEET_NAME" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Email"],
          "value": {
            "Email": "={{ $(\"Prepare Email Body\").item.json.Email }}",
            "Status": "Company Profile Has Been Sent",
            "Last Contact Date": "={{ $now.toFormat(\"yyyy-MM-dd\") }}"
          }
        },
        "options": { "cellFormat": "USER_ENTERED" }
      },
      "name": "Update Outreach Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [2420, 300]
    }
  ],
  "connections": {
    "Called by Command Center": { "main": [[{ "node": "Read No Action Buyers", "type": "main", "index": 0 }]] },
    "Read No Action Buyers": { "main": [[{ "node": "Filter Outreach Targets", "type": "main", "index": 0 }]] },
    "Filter Outreach Targets": { "main": [[{ "node": "Create Personalized Opening", "type": "main", "index": 0 }]] },
    "OpenAI Personalization Model": { "ai_languageModel": [[{ "node": "Create Personalized Opening", "type": "ai_languageModel", "index": 0 }]] },
    "Create Personalized Opening": { "main": [[{ "node": "Prepare Email Body", "type": "main", "index": 0 }]] },
    "Prepare Email Body": { "main": [[{ "node": "Download Company Profile PDF", "type": "main", "index": 0 }]] },
    "Download Company Profile PDF": { "main": [[{ "node": "Download Catalog Product PDF", "type": "main", "index": 0 }]] },
    "Download Catalog Product PDF": { "main": [[{ "node": "Send Company Profile Email", "type": "main", "index": 0 }]] },
    "Send Company Profile Email": { "main": [[{ "node": "Update Outreach Status", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
